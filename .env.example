# iFan.asia — biến môi trường (điền giá trị thật vào .env.local, KHÔNG commit .env.local)
# File này chỉ chứa placeholder — không bao giờ đặt giá trị thật ở đây.

# ---------- Supabase (public — client dùng được) ----------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# ---------- Supabase (CHỈ server — Vercel env / CI secret, tuyệt đối không prefix NEXT_PUBLIC_) ----------
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Chuỗi kết nối Postgres trực tiếp (pooler IPv4) — cho scripts/rls-smoke.mjs và `supabase db push`
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@<region>.pooler.supabase.com:5432/postgres

# ---------- Cho script test RLS qua client SDK (trùng giá trị public ở trên) ----------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>

# ---------- Zalo OA (CHỈ server — webhook app/api/webhooks/zalo) ----------
ZALO_APP_ID=<zalo-app-id>
ZALO_APP_SECRET=<zalo-app-secret>
# Khóa nội bộ xác thực webhook trước khi gọi RPC ingest_zalo_event (trùng private.app_config 'zalo_ingest_key')
ZALO_INGEST_KEY=<zalo-ingest-key>
# CHỈ máy dev: bỏ qua verify chữ ký khi chưa có ZALO_APP_ID/SECRET.
# ĐỪNG BAO GIỜ đặt biến này trên Vercel (kể cả preview) — preview là URL công
# khai và đang nối vào CSDL thật, đặt vào là ai cũng ghi được dữ liệu giả.
ZALO_WEBHOOK_ALLOW_UNSIGNED=

# ---------- AI Claude API (CHỈ server) — bỏ trống thì tính năng AI tắt, app vẫn chạy bình thường ----------
ANTHROPIC_API_KEY=<anthropic-api-key>
# Tùy chọn: đổi model (mặc định claude-opus-5) và trần lượt AI/tenant/tháng (mặc định 300).
# ⚠️ Trần này PHẢI ≥ hạn mức gói cao nhất đang bán (nay là 300 — ADR-0011 mục 4c.1),
# đặt thấp hơn là chặn NHẦM khách trả tiền dùng đúng số lượt đã mua.
AI_MODEL=claude-opus-5
AI_MONTHLY_CAP=300

# ---------- Upstash Redis (CHỈ server — rate limit lib/rate-limit.ts; bỏ trống thì rate limit tắt) ----------
UPSTASH_REDIS_REST_URL=https://<db-name>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<upstash-rest-token>

# ---------- Vercel tự cung cấp khi deploy — KHÔNG cần điền ----------
# VERCEL_ENV=production|preview|development
